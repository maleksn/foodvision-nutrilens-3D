# Optional: USDA FoodData Central API key (get a free key at https://fdc.nal.usda.gov/api-key-signup.html)
# If omitted, NutriLens falls back to built-in standard nutritional profiles.
USDA_API_KEY=your_usda_fooddata_central_api_key_here

# Optional: Custom path to the SAM 2.1 Hiera Large checkpoint
SAM2_CHECKPOINT=./checkpoints/sam2.1_hiera_large.pt
